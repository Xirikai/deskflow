{
  "name": "deskflow",
  "productName": "DeskFlow",
  "version": "1.0.1",
  "private": true,
  "main": "main.cjs",
  "description": "Личные инструменты Windows: файлы, скриншоты, запуск и звук",
  "author": "Personal Tools",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "npm run native:build && electron-builder --win portable",
    "native:build": "node scripts/build-native.mjs",
    "setup": "node scripts/setup-runtime.mjs && npm run native:build"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.personaltools.deskflow",
    "productName": "DeskFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "core/**/*",
      "native/**/*",
      "package.json",
      "!native/vendor/**/*",
      "LICENSE",
      "THIRD-PARTY.md",
      "licenses/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "native/**/*"
    ],
    "compression": "store",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "DeskFlow-Windows-v1.0.1.exe"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
